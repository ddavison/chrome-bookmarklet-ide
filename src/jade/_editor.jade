doctype
html
  head
    script(type='application/javascript' src='assets/js/settings.js')
    script(type='application/javascript' src='assets/third-party/jquery/jquery.min.js')

    include _foundation

    meta(http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline' blob: filesystem:")

    block title
    link(rel='stylesheet' href='assets/css/editor.css')
    link(rel='stylesheet' href='assets/third-party/vs/editor/editor.main.css')

    script(type='application/javascript' src='assets/third-party/vs/loader.js')
    script(type='application/javascript' src='assets/js/formatter.js')
    script(type='application/javascript' src='assets/js/ide.js')
  body#ide-editor.grid-y.large-grid-frame
    header#ide-editor-header.grid-x.cell.large-2.grid-margin-x
      img(src='assets/images/ide-logo-512.png')#ide-editor-logo.cell.large-2
      #ide-editor-file-container.cell.large-8
        input#ide-editor-file-name(type='text' value='Untitled')

      #ide-editor-top-controls.button-group.cell.auto
        // Play button
        a#ide-editor-btn-run.button
          span.icon.fa.fa-play(title="Run bookmarklet now")

        // Format File button
        a#ide-editor-btn-formatfile.button
          span.icon.fa.fa-paint-brush(title="Beautify code")

        // Save bookmarklet button
        a#ide-editor-btn-save.button
          span.icon.fa.fa-save(title="Save bookmarklet")

        a#ide-editor-lnk-editoroptions.clear.button
          span.icon.fa.fa-gear

    // Monaco Editor
    section#ide-editor-code.grid-x.cell.large-expanded
      block content

    script(type='application/javascript' src='assets/js/editor.js')
