doctype
html
  head
    include jade/_foundation
    title Hi there
    link(rel='stylesheet' href='assets/css/options.css')

body
  label Project Directory
    input#ide-options-txt-projectdir(type='text')
  br

  label Font size
    input#ide-options-txt-fontsize(type='number')
  br

  label Theme
    select#ide-options-theme
      option(value="vs") Visual Studio
      option(value="vs-dark") Visual Studio Dark
      option(value="hc-black") High Contrast Dark
  br

  input(type='checkbox')#ide-options-chk-showlinenumbers
  label(for='ide-options-chk-showlinenumbers') Show Line Numbers

  br
  br

  #ide-options-status
  a.float-right#ide-options-btn-save.button
    spanicon.fa.fa-save
    | Save


  script(type='application/javascript' src='assets/js/settings.js')
  script(type='application/javascript' src='assets/js/options.js')
